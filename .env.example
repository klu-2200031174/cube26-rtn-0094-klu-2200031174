# Copy this file to .env and fill in your values. .env is git-ignored - never commit it.

# gemini | offline   (offline = no model; every case goes to human review)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is unavailable / over quota (comma separated)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_TIMEOUT_S=90

# Org sign-in tokens: org_id:token pairs. Change these for anything beyond a local demo.
ORG_TOKENS=org_demo_alpha:alpha-demo-token,org_demo_bravo:bravo-demo-token

HOST=127.0.0.1
PORT=8000
# Where the SQLite database and photos are stored (git-ignored)
VAR_DIR=var
